{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "mailpit chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "mailpit": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "webroot": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "maxMessages": {
          "type": "integer",
          "minimum": 0
        },
        "maxAge": {
          "type": "string",
          "pattern": "^$|^[0-9]+[hd]$"
        },
        "maxMessageSize": {
          "type": [
            "string",
            "integer"
          ]
        },
        "disableVersionCheck": {
          "type": "boolean"
        },
        "ui": {
          "type": "object",
          "properties": {
            "auth": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "htpasswd": {
                  "type": "string"
                },
                "existingSecret": {
                  "type": "string"
                },
                "existingSecretKey": {
                  "type": "string",
                  "default": "ui.htpasswd"
                }
              },
              "additionalProperties": false
            },
            "tls": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "secretName": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "allowedHosts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "apiCors": {
              "type": "string"
            },
            "blockRemoteCssAndFonts": {
              "type": "boolean"
            },
            "hideDeleteAllButton": {
              "type": "boolean"
            },
            "disableHttpCompression": {
              "type": "boolean"
            },
            "allowInternalHttpRequests": {
              "type": "boolean"
            },
            "disableLinkCheckRateLimit": {
              "type": "boolean"
            },
            "allowUntrustedTls": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "sendApi": {
          "type": "object",
          "properties": {
            "auth": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "htpasswd": {
                  "type": "string"
                },
                "existingSecret": {
                  "type": "string"
                },
                "existingSecretKey": {
                  "type": "string"
                },
                "acceptAny": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "smtp": {
          "type": "object",
          "properties": {
            "auth": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "htpasswd": {
                  "type": "string"
                },
                "existingSecret": {
                  "type": "string"
                },
                "existingSecretKey": {
                  "type": "string"
                },
                "acceptAny": {
                  "type": "boolean"
                },
                "allowInsecure": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "tls": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "secretName": {
                  "type": "string"
                },
                "requireStartTLS": {
                  "type": "boolean"
                },
                "requireTLS": {
                  "type": "boolean"
                },
                "certManager": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "issuerRef": {
                      "type": "object"
                    },
                    "dnsNames": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "duration": {
                      "type": "string"
                    },
                    "renewBefore": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "selfSigned": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "allowedRecipients": {
              "type": "string"
            },
            "maxRecipients": {
              "type": [
                "string",
                "integer"
              ]
            },
            "disableRDNS": {
              "type": "boolean"
            },
            "strictRfcHeaders": {
              "type": "boolean"
            },
            "ignoreRejectedRecipients": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "serviceMonitor": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "interval": {
                  "type": "string"
                },
                "scrapeTimeout": {
                  "type": "string"
                },
                "labels": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "info",
            "quiet",
            "verbose"
          ]
        },
        "compression": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 0
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          ]
        },
        "useMessageDates": {
          "type": "boolean"
        },
        "ignoreDuplicateIds": {
          "type": "boolean"
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string"
            },
            "disableWAL": {
              "type": "boolean"
            },
            "disableAutoVacuum": {
              "type": "boolean"
            },
            "tenantId": {
              "type": "string"
            }
          }
        },
        "spamCheck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "engine": {
              "type": "string",
              "enum": [
                "",
                "spamassassin",
                "rspamd"
              ]
            },
            "address": {
              "type": "string"
            }
          }
        },
        "tags": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "filters": {
              "type": "string"
            },
            "titleCase": {
              "type": "boolean"
            },
            "disable": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "plus-addresses",
                  "x-tags"
                ]
              },
              "uniqueItems": true
            },
            "username": {
              "type": "boolean"
            }
          }
        },
        "webhook": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^$|^https?://"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string"
            },
            "limit": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 0
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ]
            },
            "delay": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            }
          }
        },
        "chaos": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "triggers": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClassName": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|K|M|G|T)?$"
        },
        "annotations": {
          "type": "object"
        },
        "retentionPolicy": {
          "type": "object",
          "properties": {
            "whenDeleted": {
              "type": "string",
              "enum": [
                "Retain",
                "Delete"
              ]
            },
            "whenScaled": {
              "type": "string",
              "enum": [
                "Retain",
                "Delete"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "httpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "smtpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "smtpService": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "annotations": {
          "type": "object"
        },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalTrafficPolicy": {
          "type": "string",
          "enum": [
            "",
            "Cluster",
            "Local"
          ]
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "host"
            ]
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "pathType": {
          "type": "string",
          "enum": [
            "Prefix",
            "ImplementationSpecific",
            "Exact"
          ]
        },
        "oauth2Proxy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string"
            },
            "allowedGroups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowedEmails": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "responseHeaders": {
              "type": "string"
            },
            "largeBuffers": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowSameNamespace": {
          "type": "boolean"
        },
        "httpFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "smtpFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metricsFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "allowDNS": {
              "type": "boolean"
            },
            "extra": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "startupProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "updateStrategy": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
